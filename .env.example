# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/luxury_store?schema=public"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=luxury_store

# JWT
# Replace this value with a strong secret in your local .env file.
JWT_SECRET="replace-with-a-strong-secret"